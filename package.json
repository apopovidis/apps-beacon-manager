{
  "name": "@autopilot/beacon-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/service/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/service/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "env:dev": "cp .env.dev .env",
    "env:prod": "cp .env.prod .env",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
